# Port the API listens on
PORT=3000

# Comma-separated list of allowed frontend origins for CORS. Defaults to "*" if unset.
CORS_ORIGIN=http://localhost:5173

# Path to the SQLite file (used only when DATABASE_URL is not set)
DB_PATH=job-queue.sqlite

# If set, the app uses Postgres instead of SQLite (e.g. on Render/Railway/Supabase)
# DATABASE_URL=postgres://user:password@host:5432/dbname
